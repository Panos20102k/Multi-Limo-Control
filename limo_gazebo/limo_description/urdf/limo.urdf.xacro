<?xml version="1.0"?>
<robot name="limo" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="robot_name" default="limo_1"/>

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="mobile_base.xacro" />
    <xacro:include filename="mobile_base_gazebo.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu.xacro" />
    <!-- <xacro:include filename="camera.xacro" /> -->

    <!-- call macros with specified arg -->
    <xacro:diff_plugin robot_name="$(arg robot_name)"/>
    <xacro:lidar_plugin robot_name="$(arg robot_name)"/>
    <xacro:imu_plugin robot_name="$(arg robot_name)"/>

</robot>